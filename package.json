{
  "name": "efis-compiler",
  "version": "1.0.1",
  "description": "Converts checklist source files to different EFIS/EFB formats",
  "scripts": {
    "init": "npm run patch && npm run build",
    "build": "webpack",
    "patch": "git apply --directory=efis-editor ./efis-editor.patch",
    "compile": "node dist/compiler.js"
  },
  "devDependencies": {
    "@types/webpack-env": "^1.18.8",
    "@types/yargs": "^17.0.35",
    "raw-loader": "^4.0.2",
    "ts-loader": "^9.6.2",
    "typescript": "~5.9.2",
    "webpack": "^5.112.1",
    "webpack-cli": "^7.2.3"
  },
  "dependencies": {
    "@types/pdfkit": "^0.17.3",
    "pdfkit": "^0.17.2",
    "yargs": "^18.2.0"
  }
}
